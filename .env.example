# Copy to .env and fill in. .env is gitignored -- never commit real tokens.

# Hugging Face access token.
# Required for: the gated DINOv3 encoder, and pushing index artifacts to the Hub.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Compute device: auto | cpu | cuda | mps
VSEARCH_DEVICE=auto

# Encoder batch size. Raise on GPU (128+), lower on a small CPU (8-16).
VSEARCH_BATCH_SIZE=32

# Hub dataset repo that prebuilt index artifacts are published to / pulled from.
VSEARCH_ARTIFACT_REPO=
