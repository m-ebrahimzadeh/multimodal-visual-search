# --- Secrets (keep first: nothing below matters if a token leaks) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Data & generated artifacts (large, reproducible, never committed) ---
# `data/` has no leading slash, so it matches a directory of that name at any
# depth -- including `web/public/data/`, which is tracked. See the negation in
# the web section below; it has to come after this line to win.
data/
artifacts/
outputs/

# Benchmark and evaluation output IS committed -- it is the evidence the
# README's tables are built from. Only bulky intermediates are excluded.
results/**/*.npy
results/**/*.onnx
*.npy
*.npz
*.faiss
*.index
*.parquet
*.onnx
*.onnx_data

# --- Web demo ---
node_modules/
.wrangler/
# A staging area for the encoder weights on their way into R2, not part of the
# deploy. 62 MB of it is one file, which is both over GitHub's warning
# threshold and 2.5x Cloudflare's per-asset cap -- the reason the weights are in
# a bucket rather than in `public/` at all. `web/README.md` documents the pull
# and the push; both are one-time, because the model is pinned by name.
web/models/
# The exported bundle IS committed. It is generated (`vsearch export-web`) and
# it does redistribute third-party dataset thumbnails, which is why it used to
# be ignored -- but CI deploys from a checkout, and a Workers assets deploy
# replaces the *entire* manifest. A bundle that is not in the checkout is not
# "left as it was"; it is deleted from the live site by the next docs typo.
# Tracking it is what makes push-to-deploy safe, and `ATTRIBUTION.md` ships
# beside the images naming where they came from.
#
# The directory itself has to be un-ignored, not just its contents: git does
# not descend into an excluded directory, so it never sees the files inside to
# re-include them. `!web/public/data/**` alone would silently do nothing.
!web/public/data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

