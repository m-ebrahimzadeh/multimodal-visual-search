.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# --- Model / dataset caches ---
.cache/
hf_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Editors & OS ---
.vscode/
.idea/
