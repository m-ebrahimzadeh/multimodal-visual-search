# --- Secrets (keep first: nothing below matters if a token leaks) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Data & generated artifacts (large, reproducible, never committed) ---
data/
artifacts/
outputs/

# Benchmark and evaluation output IS committed -- it is the evidence the
# README's tables are built from. Only bulky intermediates are excluded.
results/**/*.npy
results/**/*.onnx
*.npy
*.npz
*.faiss
*.index
*.parquet
*.onnx
*.onnx_data

# --- Web demo ---
node_modules/
.wrangler/
# The exported bundle is generated (`vsearch export-web`) and holds copies of
# third-party dataset thumbnails. Keeping it out of the repo avoids
# redistributing someone else's images here; `wrangler deploy` uploads it from
# the working tree. Commit it only if you want Cloudflare's Git integration to
# build without a local export step first.
web/public/data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# --- Model / dataset caches ---
.cache/
hf_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Editors & OS ---
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini
